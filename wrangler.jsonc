{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sweetpotato",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
   "assets": {
    "directory": ".",
    "exclude_patterns": [
      "**/.git/**",
      "**/node_modules/**"
    ]
  }

  }

